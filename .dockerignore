# ============================================================
# .dockerignore - Docker 构建时忽略的文件
# ============================================================

# 依赖目录（构建时会重新 npm install）
node_modules/

# 构建产物（Docker 内会重新构建）
dist/
dist-ssr/

# Git 相关
.git/
.gitignore

# IDE 和编辑器配置
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 日志文件
*.log
npm-debug.log*

# 系统文件
.DS_Store
Thumbs.db

# Docker 相关（避免循环）
Dockerfile
.dockerignore

# 测试覆盖率
coverage/

# 文档
docs/
*.md
!README.md

# Claude / Superpowers
.claude/
.superpowers/

# 本地配置文件
*.local
